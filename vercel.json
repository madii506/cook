{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ]},
    { "source": "/(.*)\\.(png|jpg)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=86400" }
    ]}
  ]
}
